classDiagram
    %% PawPal+ class design. Keep this file updated so it matches your final implementation.

    class Owner {
        +str name
        +int available_minutes
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +get_pets() list~Pet~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(task: Task) None
        +get_tasks() list~Task~
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +str preferred_time
        +edit(**fields) None
        +is_high_priority() bool
    }

    class Scheduler {
        +Owner owner
        +list~Task~ tasks
        +sort_by_priority() list~Task~
        +fits_in_time(task: Task, minutes_left: int) bool
        +generate_plan() DailyPlan
    }

    class DailyPlan {
        +list~Task~ scheduled_tasks
        +list~Task~ skipped_tasks
        +list~str~ reasons
        +total_time() int
        +explain() str
        +to_table() list~dict~
    }

    Owner "1" o-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : has
    Scheduler --> Owner : plans for
    Scheduler ..> Task : considers
    Scheduler ..> DailyPlan : creates
    DailyPlan o-- Task : contains
